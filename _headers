# Netlify custom response headers. Rules match the REQUEST path, so they apply
# to SPA routes even though every path rewrites to /index.html via _redirects.
#
# Why noindex on the card and live-page routes: those pages publish a
# customer's phone number and email address. Keeping them out of the search
# index is a privacy decision, not an SEO one, and it holds regardless of what
# AdSense decides about this domain.
#
# Why a header and not just robots.txt: robots.txt blocks the CRAWL, which
# means Google never fetches the page and therefore never reads a noindex.
# A blocked URL can still be listed as a bare link with no snippet if Google
# finds it referenced somewhere. X-Robots-Tag is the directive that actually
# removes a page from the index, and it only works if crawling is ALLOWED.
#
# Sequencing, do not skip: the Disallow lines in robots.txt must stay until
# this header is confirmed live (see the verify command in robots.txt).
# Dropping the Disallow first would open these pages to indexing with nothing
# in place to stop it.

# Every page. SAMEORIGIN rather than DENY: nothing frames the site from
# elsewhere, and this keeps any same-origin frame working. A login token in
# localStorage makes clickjacking and content sniffing worth closing off.
#
# The Content Security Policy is report-only: browsers log what it would block
# and block nothing. It becomes enforcing once a clean run of the live site
# shows no violation it should not have. Scripts are 'self' plus named hosts,
# with no 'unsafe-inline': that is what stops an injected script reading the
# token. blob: is there because the voice agent builds its audio worklets
# from blob URLs (worklets fall under script-src), and the one jsdelivr
# file is the worklet it fetches on Firefox. Styles keep 'unsafe-inline'
# because React writes style attributes.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' blob: https://accounts.google.com/gsi/client https://www.googletagmanager.com https://client.crisp.chat https://cdn.jsdelivr.net/npm/@alexanderolsen/libsamplerate-js@2.1.2/dist/libsamplerate.worklet.js; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style https://fonts.googleapis.com https://client.crisp.chat; font-src 'self' data: https://fonts.gstatic.com https://client.crisp.chat; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://api.digitalqrcard.com https://client.crisp.chat https://storage.googleapis.com https://api.us.elevenlabs.io; connect-src 'self' https://accounts.google.com/gsi/ https://api.digitalqrcard.com https://api.elevenlabs.io wss://api.elevenlabs.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://client.crisp.chat https://client.relay.crisp.chat wss://client.relay.crisp.chat https://stream.relay.crisp.chat wss://stream.relay.crisp.chat https://storage.crisp.chat; frame-src https://accounts.google.com/gsi/ https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://game.crisp.chat https://www.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Vite's own build output (JS/CSS chunks) lands here with a content hash in
# the filename, so a given path's bytes never change and a long-lived cache
# can't go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# /assets/images/* is a second, unrelated thing that happens to share the
# /assets/ prefix: public/assets/images/*.{jpg,png} are copied verbatim by
# Vite (unhashed filenames), not built. The immutable rule above would catch
# them too and strand a replaced image in caches for a year. Netlify applies
# every matching block and, for a header both declare, the one declared later
# in this file wins — so this has to come after /assets/*, not before.
/assets/images/*
  Cache-Control: public, max-age=0, must-revalidate

/c/*
  X-Robots-Tag: noindex

# Sign-in and account pages: not search results.
/login
  X-Robots-Tag: noindex

/register
  X-Robots-Tag: noindex

/forgot-password
  X-Robots-Tag: noindex

/oauth/*
  X-Robots-Tag: noindex

/team
  X-Robots-Tag: noindex

/c1/*
  X-Robots-Tag: noindex

/p/*
  X-Robots-Tag: noindex

# llms.txt / llms-full.txt (generate-llms.js, build/): the proposed
# convention for telling an AI agent what the site is. Served as plain text
# so an agent reading it gets markdown, not an HTML content type.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
